{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal Club",
  "version": "0.1.0",
  "identifier": "com.ysomp.journal-club",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Journal Club",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/jc-download"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEN0RFNzA0NjQ5RTgyRkIKUldUN2dwNWtCT2Q5dllXNExsdnFJZjJSaUlUVXNkZ2dkZWVlMkRoNjNRTUhqN09HZ1hCcHZDeEEK",
      "endpoints": ["https://api.labor-ai.org/desktop/latest"]
    }
  }
}
