{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal Club",
  "version": "0.2.0",
  "identifier": "com.ysomp.journal-club",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Journal Club",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/jc-download"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RTFFODU0NkU2Mjg1ODAKUldTQWhXSnVWT2podHlRUjEyYkZETHI2YmE4aDZMQ3pPWklKQlVJSkpySVJYZEhiZzJwR1plL1MK",
      "endpoints": ["https://api.labor-ai.org/desktop/latest"]
    }
  }
}
